NODE_ENV=development
API_PORT=4000
# Managed hosts such as Render inject PORT automatically; do not set it locally.
# Comma-separate exact frontend origins. Do not include URL paths.
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=swiftopsbd
FIREBASE_STORAGE_BUCKET=swiftopsbd.firebasestorage.app
# Local-only absolute path. Keep the JSON key outside this repository.
FIREBASE_SERVICE_ACCOUNT_FILE=C:\secure\swiftopsbd-service-account.json
BARIKOI_API_KEY=replace_with_barikoi_api_key
BARIKOI_API_BASE_URL=https://barikoi.xyz
PAYMENT_MODE=gateway
PAYMENT_GATEWAY=stripe
PAYMENT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_MODE=demo

# SSLCommerz hosted checkout. Use sandbox until merchant verification is done.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=replace_with_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=replace_with_sslcommerz_store_password
# Public HTTPS API URL used by SSLCommerz callbacks (ngrok in local sandbox).
API_PUBLIC_URL=https://your-api-service.onrender.com

# Local development can use "local". Deployment should use "supabase".
FILE_STORAGE_PROVIDER=supabase
LOCAL_UPLOAD_DIR=uploads

# Private Supabase Storage (server secrets only; never use a VITE_ prefix).
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_SECRET_KEY=replace_with_backend_sb_secret_key
SUPABASE_STORAGE_BUCKET=swiftops-private-documents
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# GOOGLE_APPLICATION_CREDENTIALS remains supported by Firebase automatically.

# Deployment alternatives. Configure only one as a protected hosting secret.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
